generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// User (Authentication & Admins)
// ---------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // "ADMIN", "WARDEN"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuPermission {
  id          String   @id @default(uuid())
  role        String   @unique
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Role Master (Developer-managed user roles)
// ---------------------------------------------------------
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Room & Bed Management
// ---------------------------------------------------------
model Room {
  id            String  @id // e.g. A1, E1, W1, 101, 102
  block         String
  floor         Int     @default(1)
  capacity      Int // Total beds in the room
  type          String // "Single", "Double", "Triple", "Four Sharing", "Dormitory"
  rent          Float   @default(0.0)
  messFee       Float   @default(0.0)
  amenities     String? // Comma separated string e.g. "AC, Attached Bath"
  occupiedCount Int     @default(0)

  students  Student[]
  ebBills   EbBill[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ---------------------------------------------------------
// Student Management
// ---------------------------------------------------------
model Student {
  id            String    @id @default(uuid())
  regNo         String    @unique // e.g. HST-2026-001
  name          String
  manualRegsiName String?   @unique
  dob           DateTime?
  age           Int?
  gender        String?
  maritalStatus String?
  bloodGroup    String?

  // Contact & KYC
  emailId          String? @unique
  mobileNo         String?
  fatherName       String?
  fatherMobileNo   String?
  motherName       String?
  motherMobileNo   String?
  guardianName     String?
  guardianMobileNo String?
  emergencyContact String?
  photoUrl         String?
  doc1Url          String?
  doc2Url          String?
  doc1Type         String?
  doc2Type         String?
  doc1Number       String?
  doc2Number       String?
  aadharNo         String? @unique
  secondaryIdNo    String?
  address          String?

  // Academic info
  collegeId      String?
  college        College? @relation(fields: [collegeId], references: [id])
  educationalQua String?
  courseDuration String?
  category       String?
  passingYear    String? // Retain passingYear just in case, or rename to pursuingYear
  pursuingYear   String?

  // Additional tracking
  vsrLedger1     String?
  dateOfJoining  DateTime?
  biometricId    String?

  // Hostel details
  foodType String? // "Veg", "Non-Veg"
  roomNo   String?
  bedNo    String? // e.g. "Bed 1", "Bed 2"
  advance  Float?  @default(0.0)
  rent     Float?  @default(0.0)
  rentPaidUntil DateTime?
  messPaidUntil DateTime?

  // Status tracking
  status    String @default("In") // "In", "Out", "Missing", "Vacated"
  feeStatus String @default("Un-Paid") // "Paid", "Un-Paid", "Partial"

  // Relations
  room         Room?            @relation(fields: [roomNo], references: [id])
  gateLogs     GateLog[]
  transactions FeeTransaction[]
  razorpayOrders RazorpayOrder[]
  clearance    ClearanceRecord?
  outpasses    Outpass[]
  messAttendances MessAttendance[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  profileUpdatedAt DateTime?
}

// ---------------------------------------------------------
// Gate Logs & Movements
// ---------------------------------------------------------
model GateLog {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  movementType   String // "EXIT", "ENTRY"
  reason         String?
  outTime        DateTime?
  expectedInTime DateTime?
  inTime         DateTime?

  isLate      Boolean @default(false)
  lateRemarks String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// Fees & Transactions
// ---------------------------------------------------------
model FeeTransaction {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  transactionType String // "RENT", "MESS", "EB_BILL", "ADVANCE", "FINE", "PAYMENT"
  amount          Float
  description     String?
  status          String // "PENDING", "COMPLETED", "FAILED"
  paymentMode     String? // "CASH", "UPI", "BANK_TRANSFER", "RAZORPAY"
  razorpayOrderId String?
  razorpayPaymentId String?
  paymentStatus   String?
  paymentMethod   String?

  // Stable, sequential invoice number assigned once (e.g. INV-2026-10-001).
  // It is never recalculated, so adding a payment cannot renumber older rows.
  invoiceNumber String?

  // Billing month this fee represents (format: YYYY-MM). Null for legacy records.
  billingMonth String?

  dueDate  DateTime?
  paidDate DateTime?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceNumber])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([studentId, billingMonth, transactionType])
  @@index([deletedAt])
}

model RazorpayOrder {
  id                     String   @id @default(uuid())
  studentId              String
  student                Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clientRequestId        String   @unique
  orderId                String?  @unique
  paymentId              String?  @unique
  paymentMethod          String?
  amountPaise            Int
  currency               String   @default("INR")
  status                 String   @default("CREATING")
  paymentStatus          String?
  feeItems               Json
  outstandingAmountPaise Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([studentId, status])
}

// One row per calendar month, used to allocate invoice numbers atomically.
model InvoiceCounter {
  period String @id // "2026-10"
  value  Int    @default(0)
}

// ---------------------------------------------------------
// EB Bills (Electricity)
// ---------------------------------------------------------
model EbBill {
  id     String @id @default(uuid())
  roomNo String
  room   Room   @relation(fields: [roomNo], references: [id])

  billingCycle  String // e.g. "2026-08"

  // Dual-meter support: AC + Normal. A room with one meter leaves AC at 0.
  hasAcMeter      Boolean @default(false)
  acPrevReading   Float   @default(0.0)
  acCurrReading   Float   @default(0.0)
  normalPrevReading Float @default(0.0)
  normalCurrReading Float @default(0.0)

  // Combined / legacy fields (prev/curr mirror the Normal meter for backward compat)
  prevReading   Float
  currReading   Float
  unitsConsumed Float   // = AC units + Normal units
  tariffRate    Float
  totalAmount   Float   // = unitsConsumed * tariffRate

  perStudentShare Float // Computed based on number of active students in the room

  createdAt DateTime @default(now())

  // A room can only have one bill per billing cycle
  @@unique([roomNo, billingCycle])
}

// ---------------------------------------------------------
// Clearance & Discontinuation
// ---------------------------------------------------------
model ClearanceRecord {
  id        String  @id @default(uuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id])

  reason      String // "Completed Course", "Disciplinary Action", "Personal"
  advanceHeld Float
  pendingDues Float
  deductions  Float  @default(0.0)
  netRefund   Float

  remarks       String?
  clearanceDate DateTime @default(now())

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// Outpass Management
// ---------------------------------------------------------
model Outpass {
  id        String  @id @default(uuid())
  outpassId String  @unique // e.g. OP-20260928-871
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  destination   String
  reason        String
  leaveDate     DateTime
  returnDate    DateTime
  parentConsent Boolean  @default(false)

  status     String @default("Pending") // "Pending", "Approved", "Closed Returned", "Rejected"
  gateAction String @default("Verify Exit") // "Verify Exit", "Done"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Fine Master
// ---------------------------------------------------------
model FineMaster {
  id         String   @id @default(uuid())
  collegeId  String   @unique
  college    College  @relation(fields: [collegeId], references: [id])
  rentFine   Float    @default(0.0)
  messFine   Float    @default(0.0)
  ebFine     Float    @default(0.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------
// College Master
// ---------------------------------------------------------
model College {
  id          String    @id @default(uuid())
  name        String    @unique
  shortName   String?
  address     String?
  dueDate     DateTime?
  billingCycle String   @default("PREPAID") // "PREPAID" or "POSTPAID"

  students   Student[]
  fineMaster FineMaster?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Mess Deduction Master
// ---------------------------------------------------------
model MessDeductionMaster {
  id                     String   @id @default("GLOBAL")
  messDeductionThreshold Int      @default(15)
  updatedAt              DateTime @updatedAt
}

model HostelSettings {
  id         Int      @id @default(1)
  hostelName String?
  address    String?
  phone      String?
  email      String?
  gstin      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------
// Electricity Tariff Rate Master (singleton)
// ---------------------------------------------------------
model EbTariffMaster {
  id        String   @id @default("GLOBAL")
  rate      Float    @default(12)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Canteen & Inventory Master Models
// ---------------------------------------------------------

model CanteenCategory {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  products    CanteenProduct[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CanteenUnit {
  id        String           @id @default(uuid())
  name      String           @unique
  symbol    String?
  products  CanteenProduct[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model CanteenSupplier {
  id        String            @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  gstNo     String?
  purchases CanteenPurchase[]
  payments  CanteenSupplierPayment[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CanteenPaymentMode {
  id        String            @id @default(uuid())
  name      String            @unique
  isSystem  Boolean           @default(false)
  purchases CanteenPurchase[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CanteenProduct {
  id            String                @id @default(uuid())
  name          String
  code          String?               @unique
  categoryId    String?
  category      CanteenCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitId        String?
  unit          CanteenUnit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  price         Float                 @default(0.0)
  costPrice     Float                 @default(0.0)
  availableStock Float                @default(0.0)
  status        String                @default("Active")
  purchaseItems CanteenPurchaseItem[]
  kitchenConsumptions KitchenConsumption[]
  stockMovements CanteenStockMovement[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

// Dated ledger of every stock change for a CanteenProduct.
// `availableStock` on CanteenProduct stays the live/cached balance, while
// this table records each individual change so that "stock as on <date>"
// can be computed exactly — including manual stock edits in Product Master.
//   quantity is SIGNED:  + increases stock, - decreases stock.
model CanteenStockMovement {
  id            String         @id @default(uuid())
  productId     String
  product       CanteenProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          String         // OPENING | PURCHASE | CONSUMPTION | ADJUSTMENT
  quantity      Float          // signed quantity (+ in / - out)
  dateStr       String         // business date, YYYY-MM-DD (used for "as on" reporting)
  referenceId   String?        // purchaseId / consumptionId (null for manual)
  referenceType String?        // PURCHASE | CONSUMPTION | MANUAL | MIGRATION
  remarks       String?
  createdAt     DateTime       @default(now())

  @@index([productId, dateStr])
  @@index([referenceType, referenceId])
}

model CanteenPurchase {
  id            String               @id @default(uuid())
  invoiceNo     String               @unique
  purchaseDate  DateTime             @default(now())
  supplierId    String?
  supplier      CanteenSupplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentModeId String?
  paymentMode   CanteenPaymentMode?  @relation(fields: [paymentModeId], references: [id], onDelete: SetNull)
  totalAmount   Float                @default(0.0)
  notes         String?
  items         CanteenPurchaseItem[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model CanteenPurchaseItem {
  id          String          @id @default(uuid())
  purchaseId  String
  purchase    CanteenPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String?
  product     CanteenProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  qty         Float
  unit        String?
  price       Float
  totalAmount Float
  createdAt   DateTime        @default(now())
}

model CanteenSupplierPayment {
  id            String             @id @default(uuid())
  paymentNo     String             @unique
  date          DateTime           @default(now())
  supplierId    String
  supplier      CanteenSupplier    @relation(fields: [supplierId], references: [id])
  amount        Float              @default(0.0)
  paymentType   String?
  reference     String?
  remarks       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// ---------------------------------------------------------
// Mess Attendance
// ---------------------------------------------------------
model MessAttendance {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dateStr     String   // Format: YYYY-MM-DD
  mealType    String   // Breakfast, Lunch, Snacks, Dinner
  scannedAt   DateTime @default(now())
  
  @@unique([studentId, dateStr, mealType])
}

// ---------------------------------------------------------
// Staff Master Data
// ---------------------------------------------------------
model Staff {
  id          String    @id @default(uuid())
  staffCode   String    @unique // e.g. STF-001, STF-005
  name        String    // Full Name
  joiningDate DateTime  @default(now())
  role        String    // e.g. Gate Security Guard, Warden, Canteen Cook
  phone       String?   // Mobile Phone
  email       String?   // Email (Optional)
  salaryBasis String    @default("Monthly Fixed") // "Monthly Fixed", "Daily Wage", "Hourly Rate"
  baseSalary  Float     @default(0.0) // Base Salary (₹)
  status      String    @default("Active") // "Active", "Inactive"
  notes       String?
  attendances StaffAttendance[]
  salaries    StaffSalary[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------
// Staff Gate In / Out Daily Attendance
// ---------------------------------------------------------
model StaffAttendance {
  id           String    @id @default(uuid())
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dateStr      String    // Format: YYYY-MM-DD
  checkInTime  String?   // e.g. "01:14 PM"
  checkOutTime String?   // e.g. "05:30 PM"
  status       String    @default("Not Marked") // "Present", "Absent", "Half Day", "On Leave", "Not Marked"
  remarks      String?   // Optional duty note
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([staffId, dateStr])
}

// ---------------------------------------------------------
// Staff Monthly Salary Disbursement
// ---------------------------------------------------------
model StaffSalary {
  id                String    @id @default(uuid())
  salaryCode        String    @unique // e.g. SAL-202610-001
  staffId           String
  staff             Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  salaryMonth       String    // Format: YYYY-MM (e.g. "2026-10")
  year              Int       // e.g. 2026
  month             String    // e.g. "October"
  baseSalary        Float     // Base salary snapshot
  bonus             Float     @default(0.0) // Bonus / Overtime (₹)
  deductions        Float     @default(0.0) // Deductions (₹)
  netAmount         Float     // Net Amount Disbursed = baseSalary + bonus - deductions
  paymentDate       DateTime  @default(now())
  paymentMode       String    @default("Direct Bank Transfer") // Direct Bank Transfer, Cash, UPI
  remarks           String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([staffId, salaryMonth])
}

// ---------------------------------------------------------
// Kitchen Construction – Daily Consumption Tracker
// ---------------------------------------------------------
model KitchenConsumption {
  id              String          @id @default(uuid())
  batchId         String?         // Groups rows entered together in one entry form
  date            DateTime        @default(now())
  dateStr         String          // Format: YYYY-MM-DD
  mealType        String          // Breakfast, Lunch, Evening Snacks, Dinner
  productId       String
  product         CanteenProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  availableStock  Float           @default(0.0)  // Snapshot of stock at the time of entry
  quantityTaken   Float           @default(0.0)  // Gross qty brought out from store
  unit            String          @default("Kg")
  wastage         Float           @default(0.0)
  netConsumed     Float           @default(0.0)  // quantityTaken - wastage
  remarks         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([batchId])
}

// ---------------------------------------------------------
// Biometric Attendance & Device Models
// ---------------------------------------------------------

model biometric_attendance_logs {
  id               BigInt    @id @default(autoincrement())
  device_id        String    @db.VarChar(50)
  user_id          String    @db.VarChar(50)
  student_id       String?   @db.VarChar(100)
  punch_time       DateTime  @db.Timestamp(6)
  punch_state      String    @db.VarChar(20)
  punch_state_code Int
  verify_type      String?   @default("Face") @db.VarChar(20)
  device_uid       Int
  synced_at        DateTime? @default(now()) @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  raw_data         Json?

  @@unique([device_id, user_id, punch_time, punch_state_code], map: "uq_device_user_punch")
  @@index([device_id, punch_time], map: "idx_biometric_logs_device_time")
  @@index([punch_time(sort: Desc)], map: "idx_biometric_logs_punch_time")
  @@index([synced_at], map: "idx_biometric_logs_synced_at")
  @@index([user_id, punch_time], map: "idx_biometric_logs_user_time")
}

model biometric_device_commands {
  id           Int       @id @default(autoincrement())
  device_id    String    @db.VarChar(50)
  command_text String
  user_id      String?   @db.VarChar(100)
  user_name    String?   @db.VarChar(200)
  status       String?   @default("PENDING") @db.VarChar(20)
  return_code  String?   @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  executed_at  DateTime? @db.Timestamptz(6)
  raw_feedback String?

  @@index([device_id, status], map: "idx_dev_cmd_status")
}

model biometric_device_registry {
  device_id               String    @id @db.VarChar(50)
  device_name             String?   @db.VarChar(100)
  ip_address              String?   @db.VarChar(50)
  serial_number           String?   @db.VarChar(100)
  firmware_version        String?   @db.VarChar(100)
  mac_address             String?   @db.VarChar(50)
  face_version            String?   @db.VarChar(50)
  platform                String?   @db.VarChar(50)
  total_records_on_device Int?      @default(0)
  is_online               Boolean?  @default(false)
  last_online_at          DateTime? @db.Timestamptz(6)
  updated_at              DateTime? @default(now()) @db.Timestamptz(6)
}

model biometric_device_users {
  id                Int       @id @default(autoincrement())
  device_id         String    @db.VarChar(50)
  user_id           String    @db.VarChar(100)
  name              String?   @db.VarChar(200)
  card_no           String?   @db.VarChar(50)
  privilege         Int?      @default(0)
  password          String?   @db.VarChar(50)
  raw_payload       String?
  synced_at         DateTime? @default(now()) @db.Timestamptz(6)
  face_count        Int?      @default(0)
  fingerprint_count Int?      @default(0)

  @@unique([device_id, user_id])
  @@index([synced_at(sort: Desc)], map: "idx_dev_user_sync")
  @@index([device_id, user_id], map: "idx_dev_user_uid")
}

model biometric_sync_state {
  device_id             String    @id @db.VarChar(50)
  device_ip             String?   @db.VarChar(50)
  last_synced_timestamp DateTime? @db.Timestamp(6)
  last_synced_uid       Int?      @default(0)
  total_synced_records  BigInt?   @default(0)
  records_in_last_batch Int?      @default(0)
  last_sync_status      String?   @default("PENDING") @db.VarChar(50)
  last_sync_time        DateTime? @db.Timestamptz(6)
  last_successful_sync  DateTime? @db.Timestamptz(6)
  last_error_message    String?
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)
}

model biometric_user_templates {
  id             Int       @id @default(autoincrement())
  device_id      String    @db.VarChar(50)
  user_id        String    @db.VarChar(100)
  template_type  String    @db.VarChar(20)
  template_index Int?      @default(0)
  template_size  Int?
  bio_version    String?   @db.VarChar(50)
  template_data  String
  raw_payload    String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  synced_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([device_id, user_id, template_type, template_index], map: "uq_dev_user_template")
  @@index([device_id, template_type], map: "idx_bio_tmp_dev")
  @@index([user_id], map: "idx_bio_tmp_user")
}

model student_daily_attendance {
  id               BigInt    @id @default(autoincrement())
  attendance_date  DateTime  @db.Date
  student_id       String
  reg_no           String?
  student_name     String?
  room_no          String?
  first_punch_time DateTime? @db.Timestamp(6)
  first_punch_type String?   @db.VarChar(20)
  last_punch_time  DateTime? @db.Timestamp(6)
  last_punch_type  String?   @db.VarChar(20)
  first_out_time   DateTime? @db.Timestamp(6)
  last_in_time     DateTime? @db.Timestamp(6)
  first_in_time    DateTime? @db.Timestamp(6)
  last_out_time    DateTime? @db.Timestamp(6)
  total_punches    Int?      @default(0)
  total_in_count   Int?      @default(0)
  total_out_count  Int?      @default(0)
  current_status   String?   @default("UNKNOWN") @db.VarChar(20)
  is_late_entry    Boolean?  @default(false)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([student_id, attendance_date], map: "uq_student_daily_att")
  @@index([attendance_date], map: "idx_student_daily_date")
  @@index([room_no], map: "idx_student_daily_room")
  @@index([student_id], map: "idx_student_daily_student")
}

model student_movement_logs {
  id               BigInt    @id @default(autoincrement())
  biometric_log_id BigInt?
  student_id       String?
  reg_no           String?
  student_name     String?
  room_no          String?
  device_id        String    @db.VarChar(50)
  direction        String    @db.VarChar(10)
  punch_time       DateTime  @db.Timestamp(6)
  punch_date       DateTime  @db.Date
  punch_state      String    @db.VarChar(20)
  verify_type      String?   @default("Face") @db.VarChar(20)
  device_uid       Int?
  remarks          String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([device_id, reg_no, punch_time, direction], map: "uq_student_movement")
  @@index([punch_date], map: "idx_student_movement_date")
  @@index([direction], map: "idx_student_movement_direction")
  @@index([reg_no], map: "idx_student_movement_reg_no")
  @@index([student_id], map: "idx_student_movement_student")
}
